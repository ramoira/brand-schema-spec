{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ramoira.com/schema/v3/SPEC.schema.json",
  "title": "Ramoira Brand Schema 3.1.0 (full and archetype)",
  "description": "Normative JSON Schema for a full brand schema (schema_type: full) and an archetype template (schema_type: archetype). The public summary has its own schema, SPEC.summary.schema.json. Checks that JSON Schema cannot express (unique ids, reference resolution, rubric sufficiency, ratification conditions, content_hash recomputation, scale ranges) are enforced by the reference validator in validation/. See SPEC.md section 9.",
  "type": "object",
  "required": ["ramoira", "rules", "identity", "narrative", "voice", "commercial", "governance"],
  "additionalProperties": false,
  "properties": {
    "ramoira": { "$ref": "#/$defs/Ramoira" },
    "rules": {
      "type": "array",
      "description": "The rule registry. The only place a prohibition or requirement lives, and the only thing that can produce a verdict.",
      "items": { "$ref": "#/$defs/Rule" }
    },
    "identity": { "$ref": "#/$defs/Identity" },
    "narrative": { "$ref": "#/$defs/Narrative" },
    "voice": { "$ref": "#/$defs/Voice" },
    "commercial": { "$ref": "#/$defs/Commercial" },
    "governance": { "$ref": "#/$defs/Governance" },
    "draft_provenance": { "$ref": "#/$defs/DraftProvenance" },
    "archetype": { "$ref": "#/$defs/Archetype" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "ramoira": { "properties": { "schema_type": { "const": "archetype" } } } }
      },
      "then": {
        "required": ["archetype"],
        "properties": {
          "ramoira": {
            "properties": {
              "brand_id": { "type": "null" },
              "ratification": { "type": "null" },
              "canonical_url": { "type": "null" }
            }
          }
        }
      },
      "else": {
        "not": { "required": ["archetype"] }
      }
    },
    {
      "description": "Version gate. A document that declares 3.0.0 carries none of the draft_provenance fields added in 3.1.0; a 3.1.0 document records who gave each closeness rating.",
      "if": {
        "properties": { "ramoira": { "properties": { "spec_version": { "const": "3.0.0" } } } }
      },
      "then": {
        "properties": { "draft_provenance": { "$ref": "#/$defs/DraftProvenanceAt300" } }
      },
      "else": {
        "properties": {
          "draft_provenance": {
            "properties": { "closeness_ratings": { "items": { "required": ["answered_by"] } } }
          }
        }
      }
    }
  ],
  "$defs": {
    "SpecVersion": {
      "type": "string",
      "enum": ["3.0.0", "3.1.0"],
      "description": "3.1.0 adds optional elicitation fields to draft_provenance (outside content_hash). A 3.0.0 document stays valid; changing spec_version alone needs no re-ratification."
    },
    "ContentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "\"sha256:\" + lowercase hex SHA-256 of the RFC 8785 (JCS) canonical form of {rules, identity, narrative, voice, commercial, governance}."
    },
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "JsonPointer": {
      "type": "string",
      "pattern": "^(/([^/~]|~[01])*)+$",
      "description": "RFC 6901 JSON pointer from the root of the schema document, e.g. /narrative/myth/culturalTension."
    },
    "IsoDate": {
      "anyOf": [
        { "type": "string", "format": "date" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "NonEmptyString": { "type": "string", "minLength": 1 },
    "StringList": { "type": "array", "items": { "$ref": "#/$defs/NonEmptyString" } },
    "Severity": {
      "type": "string",
      "enum": ["absolute", "strong", "contextual"],
      "description": "The only enforcement setting. The violation response is derived by the Verification Protocol (absolute: block_output; strong: flag_for_review; contextual: log_for_audit) and is never stored."
    },
    "CheckClass": {
      "type": "string",
      "enum": ["deterministic_exact", "deterministic_structural", "judged_bounded"],
      "description": "There is no advisory_only rule. Advisory material is density and lives in the layers."
    },
    "OutputSurface": {
      "type": "string",
      "enum": [
        "search_result_page", "paid_landing_page", "product_detail_page", "comparison_page",
        "editorial", "brand_narrative", "social_organic", "social_paid", "email_acquisition",
        "email_retention", "display_ad", "video_script", "audio_script", "press_release",
        "customer_service", "packaging_copy", "out_of_home"
      ],
      "description": "Where content appears. The one canonical surface list; the verdict record uses the same values."
    },
    "UserIntent": {
      "type": "string",
      "enum": [
        "high_intent_buyer", "early_research", "brand_discovery", "competitor_comparison",
        "post_purchase", "service_enquiry", "press_media", "investor"
      ],
      "description": "Who content is for."
    },
    "FallbackBehaviour": {
      "type": "string",
      "enum": ["refuse_to_generate", "escalate_to_human", "use_brand_default", "use_minimal_safe"],
      "description": "The brand's instruction to its own producers. Ramoira never executes it."
    },
    "SentenceLength": {
      "type": "string",
      "enum": ["short", "varied", "long", "fragments_permitted"]
    },
    "HexColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "Scale": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "description": "A value on a shared anchored scale (SPEC.md section 6.6)."
    },
    "ScaleDelta": { "type": "integer", "minimum": -10, "maximum": 10 },
    "SurfaceScope": {
      "oneOf": [
        { "const": "all" },
        { "type": "array", "items": { "$ref": "#/$defs/OutputSurface" }, "minItems": 1, "uniqueItems": true }
      ]
    },
    "MarketScope": {
      "oneOf": [
        { "const": "all" },
        { "type": "array", "items": { "$ref": "#/$defs/NonEmptyString" }, "minItems": 1, "uniqueItems": true }
      ]
    },
    "SituationScope": {
      "oneOf": [
        { "const": "any" },
        { "type": "array", "items": { "$ref": "#/$defs/Id" }, "minItems": 1, "uniqueItems": true }
      ]
    },

    "Ramoira": {
      "type": "object",
      "description": "Metadata. Outside content_hash. Carries no result of any kind.",
      "required": [
        "spec_version", "schema_type", "brand_id", "schema_version", "content_hash",
        "workflow_state", "ratification", "account_owner_verified", "canonical_url"
      ],
      "additionalProperties": false,
      "properties": {
        "spec_version": { "$ref": "#/$defs/SpecVersion" },
        "schema_type": {
          "type": "string",
          "enum": ["full", "archetype"],
          "description": "full: the brand's own schema. archetype: a drafting-instrument template, never ratifiable. (summary: see SPEC.summary.schema.json.)"
        },
        "brand_id": { "type": ["string", "null"], "minLength": 1 },
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "description": "A human label only. Versioning truth is content_hash."
        },
        "content_hash": { "$ref": "#/$defs/ContentHash" },
        "workflow_state": {
          "type": "string",
          "enum": ["draft", "in_review", "published", "archived"],
          "description": "Publication lifecycle only. Never encodes ratification or certification."
        },
        "ratification": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Ratification" }]
        },
        "account_owner_verified": {
          "type": "boolean",
          "description": "The account controls this slug. Never read as ratification."
        },
        "canonical_url": { "type": ["string", "null"], "format": "uri" },
        "summary_opt_in": { "$ref": "#/$defs/SummaryOptIn" }
      }
    },
    "SummaryOptIn": {
      "type": "array",
      "description": "Default-excluded material the brand chooses to include in its public summary. Identical options at every tier. Outside content_hash: a publishing choice, not brand meaning.",
      "items": { "type": "string", "enum": ["commercial", "governance", "sacred_boundary"] },
      "uniqueItems": true
    },
    "Ratification": {
      "type": "object",
      "description": "A pointer only. Ramoira's record holds the authoritative copy.",
      "required": ["ratification_id", "ratified_hash", "ratified_at", "ratifier_role"],
      "additionalProperties": false,
      "properties": {
        "ratification_id": { "$ref": "#/$defs/Id" },
        "ratified_hash": { "$ref": "#/$defs/ContentHash" },
        "ratified_at": { "type": "string", "format": "date-time" },
        "ratifier_role": { "$ref": "#/$defs/NonEmptyString" }
      }
    },

    "Rule": {
      "type": "object",
      "required": [
        "rule_id", "statement", "check_class", "severity", "topic", "surfaces", "markets",
        "situations", "modality", "visibility", "provenance", "affirmed"
      ],
      "additionalProperties": false,
      "properties": {
        "rule_id": { "$ref": "#/$defs/Id" },
        "statement": { "$ref": "#/$defs/NonEmptyString" },
        "check_class": { "$ref": "#/$defs/CheckClass" },
        "severity": { "$ref": "#/$defs/Severity" },
        "topic": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$",
          "description": "Dot path naming what the rule is about, e.g. commercial.pricing.urgency."
        },
        "surfaces": { "$ref": "#/$defs/SurfaceScope" },
        "markets": { "$ref": "#/$defs/MarketScope" },
        "situations": { "$ref": "#/$defs/SituationScope" },
        "modality": { "type": "string", "enum": ["text", "visual", "audio"] },
        "visibility": {
          "type": "string",
          "enum": ["public", "private"],
          "description": "Governs the public summary only. Conventionally private for commercial.* and governance.* topics, public otherwise; the brand may change either."
        },
        "rationale": { "type": ["string", "null"] },
        "match": { "$ref": "#/$defs/Match" },
        "predicate": { "$ref": "#/$defs/Predicate" },
        "rubric": { "$ref": "#/$defs/Rubric" },
        "provenance": { "type": "string", "enum": ["authored", "adapted", "inherited"] },
        "affirmed": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "check_class": { "const": "deterministic_exact" } } },
          "then": { "required": ["match"], "not": { "anyOf": [{ "required": ["predicate"] }, { "required": ["rubric"] }] } }
        },
        {
          "if": { "properties": { "check_class": { "const": "deterministic_structural" } } },
          "then": { "required": ["predicate"], "not": { "anyOf": [{ "required": ["match"] }, { "required": ["rubric"] }] } }
        },
        {
          "if": { "properties": { "check_class": { "const": "judged_bounded" } } },
          "then": { "required": ["rubric"], "not": { "anyOf": [{ "required": ["match"] }, { "required": ["predicate"] }] } }
        }
      ]
    },
    "Match": {
      "type": "object",
      "required": ["terms", "mode", "normalization"],
      "additionalProperties": false,
      "properties": {
        "terms": { "type": "array", "items": { "$ref": "#/$defs/NonEmptyString" }, "minItems": 1, "uniqueItems": true },
        "mode": { "type": "string", "enum": ["substring", "word", "phrase"] },
        "normalization": { "type": "string", "enum": ["casefold_nfkc", "exact"] }
      }
    },
    "Predicate": {
      "type": "object",
      "required": ["type", "params"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Named structural predicate, e.g. max_number, required_phrase_on_surface, claim_must_be_approved, self_reference_form, max_sentence_words. A verifier that does not implement a predicate returns not_evaluable for the rule."
        },
        "params": { "type": "object" }
      }
    },
    "Rubric": {
      "type": "object",
      "required": ["question", "example_refs", "rail_refs"],
      "additionalProperties": false,
      "properties": {
        "question": { "type": ["string", "null"] },
        "example_refs": { "type": "array", "items": { "$ref": "#/$defs/Id" }, "uniqueItems": true },
        "rail_refs": { "type": "array", "items": { "$ref": "#/$defs/Id" }, "uniqueItems": true }
      },
      "anyOf": [
        { "properties": { "example_refs": { "minItems": 2 } } },
        { "properties": { "rail_refs": { "minItems": 1 } } }
      ]
    },

    "Rail": {
      "type": "object",
      "required": ["rail_id", "context", "instruction"],
      "additionalProperties": false,
      "properties": {
        "rail_id": { "$ref": "#/$defs/Id" },
        "context": { "$ref": "#/$defs/NonEmptyString" },
        "instruction": { "$ref": "#/$defs/NonEmptyString" },
        "example": { "$ref": "#/$defs/NonEmptyString" },
        "antiExample": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "RailList": { "type": "array", "items": { "$ref": "#/$defs/Rail" } },
    "Example": {
      "type": "object",
      "description": "A brand-judged example. Rubric material for judged_bounded rules and density for producers.",
      "required": ["example_id", "surface", "text", "verdict", "reason", "judged_by", "source"],
      "additionalProperties": false,
      "properties": {
        "example_id": { "type": "string", "pattern": "^ex_[A-Za-z0-9_.:-]{1,124}$" },
        "surface": {
          "anyOf": [{ "$ref": "#/$defs/OutputSurface" }, { "$ref": "#/$defs/NonEmptyString" }]
        },
        "text": { "$ref": "#/$defs/NonEmptyString" },
        "verdict": { "type": "string", "enum": ["approved", "rejected"] },
        "reason": { "$ref": "#/$defs/NonEmptyString" },
        "judged_by": {
          "type": "string",
          "enum": [
            "brand_owner", "brand_team", "agency", "freelancer", "ramoira_facilitator",
            "archetype_template", "ramoira_draft"
          ],
          "description": "Only brand_owner and brand_team examples can ground a verdict in a ratified schema."
        },
        "source": { "type": "string", "enum": ["authored", "owner_reaction", "inherited", "imported_document"] },
        "captured_at": { "$ref": "#/$defs/IsoDate" }
      }
    },
    "Claim": {
      "type": "object",
      "description": "A ratified fact. claim_must_be_approved rules check against this list.",
      "required": ["claim_id", "claim"],
      "additionalProperties": false,
      "properties": {
        "claim_id": { "$ref": "#/$defs/Id" },
        "claim": { "$ref": "#/$defs/NonEmptyString" },
        "evidenceRequired": { "type": "boolean" },
        "evidenceType": { "type": ["string", "null"] },
        "markets": { "$ref": "#/$defs/MarketScope" },
        "surfaces": { "$ref": "#/$defs/SurfaceScope" }
      }
    },

    "Identity": {
      "type": "object",
      "required": ["prism"],
      "additionalProperties": false,
      "properties": {
        "prism": {
          "type": "object",
          "description": "Kapferer's brand identity prism, used as a layout for density material.",
          "additionalProperties": false,
          "properties": {
            "physique": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "permitted": { "$ref": "#/$defs/StringList" },
                "posture": { "type": "string" },
                "referenceURL": { "type": "string", "format": "uri" }
              }
            },
            "personality": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "characterBrief": { "type": "string" }
              }
            },
            "culture": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "coreValues": { "$ref": "#/$defs/StringList" },
                "originNarrative": { "type": "string" },
                "sacredBoundary": {
                  "type": "string",
                  "description": "Excluded from the public summary unless the brand opts in."
                }
              }
            },
            "relationship": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "formality": { "$ref": "#/$defs/Scale" },
                "warmth": { "$ref": "#/$defs/Scale" }
              }
            },
            "reflection": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "depictedCustomer": { "type": "string" },
                "ageSignal": { "type": "string" }
              }
            },
            "selfImage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "feelingDescriptors": { "$ref": "#/$defs/StringList" },
                "identityStatement": { "type": "string" }
              }
            }
          }
        },
        "distinctiveAssets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "visual": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "primaryColor": { "$ref": "#/$defs/HexColor" },
                "secondaryColors": { "type": "array", "items": { "$ref": "#/$defs/HexColor" } },
                "logoUsage": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "minimumClearSpace": { "type": "string" }
                  }
                },
                "iconography": { "$ref": "#/$defs/StringList" },
                "characterAssets": { "$ref": "#/$defs/StringList" },
                "photographyStyle": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "permitted": { "$ref": "#/$defs/StringList" },
                    "lightingMood": { "type": "string" }
                  }
                }
              }
            },
            "sonic": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sonicLogoURL": { "type": "string", "format": "uri" },
                "permittedGenres": { "$ref": "#/$defs/StringList" },
                "instrumentalMood": { "type": "string" }
              }
            },
            "linguistic": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ownedPhrases": { "$ref": "#/$defs/StringList" },
                "ownedWords": { "$ref": "#/$defs/StringList" },
                "typographicVoice": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sentenceStructure": { "type": "string" },
                    "punctuationStyle": { "type": "string" },
                    "numeralStyle": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },

    "Narrative": {
      "type": "object",
      "required": ["semiotic", "myth"],
      "additionalProperties": false,
      "properties": {
        "semiotic": {
          "type": "object",
          "required": ["denotative", "connotative"],
          "additionalProperties": false,
          "properties": {
            "denotative": {
              "type": "object",
              "description": "Facts: what rules check against.",
              "required": ["categoryDescriptor"],
              "additionalProperties": false,
              "properties": {
                "categoryDescriptor": { "$ref": "#/$defs/NonEmptyString" },
                "specifications": { "$ref": "#/$defs/StringList" },
                "claims": { "type": "array", "items": { "$ref": "#/$defs/Claim" } }
              }
            },
            "connotative": {
              "type": "object",
              "required": ["meaningClusters", "emotionalRegister"],
              "additionalProperties": false,
              "properties": {
                "meaningClusters": { "type": "array", "items": { "$ref": "#/$defs/NonEmptyString" }, "minItems": 1 },
                "emotionalRegister": { "$ref": "#/$defs/NonEmptyString" }
              }
            }
          }
        },
        "myth": {
          "type": "object",
          "required": ["mythStatement"],
          "additionalProperties": false,
          "properties": {
            "culturalTension": { "type": "string" },
            "mythStatement": { "$ref": "#/$defs/NonEmptyString" },
            "protagonistRole": { "type": "string" },
            "antagonist": { "type": "string" }
          }
        },
        "mythEvolution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "principle": { "type": "string" },
            "immutableCore": { "type": "string" },
            "modernTensions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["tension"],
                "additionalProperties": false,
                "properties": {
                  "tension": { "$ref": "#/$defs/NonEmptyString" },
                  "mythResolution": { "type": "string" },
                  "permittedFraming": { "$ref": "#/$defs/StringList" },
                  "rails": { "$ref": "#/$defs/RailList" }
                }
              }
            }
          }
        },
        "pillars": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "coreClaim"],
            "additionalProperties": false,
            "properties": {
              "name": { "$ref": "#/$defs/NonEmptyString" },
              "description": { "type": "string" },
              "coreClaim": { "$ref": "#/$defs/NonEmptyString" },
              "approvedArcs": { "$ref": "#/$defs/StringList" },
              "surfaces": { "type": "array", "items": { "$ref": "#/$defs/OutputSurface" }, "uniqueItems": true },
              "rails": { "$ref": "#/$defs/RailList" }
            }
          }
        },
        "editorial": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "openingPrinciple": { "type": "string" },
            "structuralApproach": { "type": "string" },
            "referencePool": { "$ref": "#/$defs/StringList" },
            "timeScaleLanguage": { "type": "string" }
          }
        },
        "guidance": {
          "type": "array",
          "description": "Test questions that lack brand-judged examples, so cannot be judged rules yet. Density only; never produces a verdict.",
          "items": {
            "type": "object",
            "required": ["question", "applies_to"],
            "additionalProperties": false,
            "properties": {
              "question": { "$ref": "#/$defs/NonEmptyString" },
              "applies_to": { "$ref": "#/$defs/SurfaceScope" }
            }
          }
        }
      }
    },

    "Voice": {
      "type": "object",
      "required": ["base", "approvedTones"],
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "object",
          "required": ["vocabularyLevel", "humourStyle"],
          "additionalProperties": false,
          "properties": {
            "vocabularyLevel": { "$ref": "#/$defs/Scale" },
            "humourStyle": {
              "type": "object",
              "required": ["style"],
              "additionalProperties": false,
              "properties": {
                "style": {
                  "$ref": "#/$defs/NonEmptyString",
                  "description": "Open vocabulary, e.g. none, dry, warm, absurdist, self_deprecating. none means humour is not permitted."
                },
                "frequency": { "type": "string", "description": "Optional qualifier, e.g. sparingly." }
              }
            },
            "permittedDevices": { "$ref": "#/$defs/StringList" }
          }
        },
        "approvedTones": { "type": "array", "items": { "$ref": "#/$defs/NonEmptyString" }, "minItems": 1 },
        "examples": { "type": "array", "items": { "$ref": "#/$defs/Example" } },
        "contextVariants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["surface"],
            "additionalProperties": false,
            "properties": {
              "surface": { "$ref": "#/$defs/OutputSurface" },
              "formalityDelta": { "$ref": "#/$defs/ScaleDelta" },
              "warmthDelta": { "$ref": "#/$defs/ScaleDelta" },
              "sentenceLength": { "$ref": "#/$defs/SentenceLength" },
              "openingInstruction": { "type": "string" },
              "closingInstruction": { "type": "string" },
              "rails": { "$ref": "#/$defs/RailList" },
              "fallbackInstruction": { "type": "string" }
            }
          }
        },
        "rails": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "global": { "$ref": "#/$defs/RailList" },
            "alternatives": {
              "type": "object",
              "description": "Rails to use when something is forbidden, keyed whenXForbidden (e.g. whenPricingForbidden).",
              "propertyNames": { "pattern": "^when[A-Z][A-Za-z]*Forbidden$" },
              "additionalProperties": { "$ref": "#/$defs/RailList" }
            }
          }
        }
      }
    },

    "Commercial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "style": { "type": "string", "description": "Open vocabulary, e.g. opaque, transparent, value_led, simple." },
            "displayFormat": { "type": "string" },
            "surfaceOverrides": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["surface"],
                "additionalProperties": false,
                "properties": {
                  "surface": { "$ref": "#/$defs/OutputSurface" },
                  "style": { "type": "string" },
                  "format": { "type": "string" }
                }
              }
            },
            "permittedLanguage": { "$ref": "#/$defs/StringList" }
          }
        },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "superlatives": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "approved": { "$ref": "#/$defs/StringList" }
              }
            }
          }
        },
        "offers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "permittedTypes": { "$ref": "#/$defs/StringList" },
            "communicationRules": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "valueFraming": { "type": "string" }
              }
            }
          }
        },
        "socialProof": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "celebrityEndorsementStyle": { "type": "string" },
            "permittedAuthoritySignals": { "$ref": "#/$defs/StringList" }
          }
        }
      }
    },

    "Governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conflictResolution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "componentPriority": {
              "type": "array",
              "items": { "type": "string", "enum": ["identity", "narrative", "voice", "commercial", "governance"] },
              "uniqueItems": true
            },
            "knownConflicts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["scenario", "resolution"],
                "additionalProperties": false,
                "properties": {
                  "scenario": { "$ref": "#/$defs/NonEmptyString" },
                  "components": { "$ref": "#/$defs/StringList" },
                  "resolution": { "$ref": "#/$defs/NonEmptyString" },
                  "example": { "type": "string" }
                }
              }
            },
            "defaultResolution": { "$ref": "#/$defs/FallbackBehaviour" }
          }
        },
        "situations": { "type": "array", "items": { "$ref": "#/$defs/Situation" } },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["surface"],
            "additionalProperties": false,
            "properties": {
              "surface": { "$ref": "#/$defs/OutputSurface" },
              "objective": { "type": "string" },
              "primaryRail": { "$ref": "#/$defs/Id", "description": "A rail_id." },
              "rails": { "$ref": "#/$defs/RailList" },
              "fallback": { "$ref": "#/$defs/FallbackBehaviour" },
              "fallbackContent": { "type": "string" },
              "intentRules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["intent", "instruction"],
                  "additionalProperties": false,
                  "properties": {
                    "intent": { "$ref": "#/$defs/UserIntent" },
                    "instruction": { "$ref": "#/$defs/NonEmptyString" }
                  }
                }
              },
              "suspended_rule_ids": {
                "type": "array",
                "items": { "$ref": "#/$defs/Id" },
                "uniqueItems": true,
                "description": "May reference only contextual rules."
              }
            }
          }
        },
        "override": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "authorisedRoles": { "$ref": "#/$defs/StringList" },
            "requiredFields": { "$ref": "#/$defs/StringList" },
            "maxDurationDays": { "type": "integer", "minimum": 1 },
            "overrideProcess": { "type": "string" },
            "judgmentBounds": { "type": "string" }
          }
        },
        "reviewTopics": { "$ref": "#/$defs/StringList" }
      }
    },
    "Situation": {
      "type": "object",
      "description": "A circumstance the brand responds to (when, as distinct from where). Activated by the principal as a time-bounded state on the brand, never declared per item by a producer.",
      "required": ["situation_id", "trigger", "category"],
      "additionalProperties": false,
      "properties": {
        "situation_id": { "type": "string", "pattern": "^sit_[A-Za-z0-9_.:-]{1,124}$" },
        "trigger": { "$ref": "#/$defs/NonEmptyString" },
        "category": {
          "type": "string",
          "enum": ["crisis", "competitor_action", "accusation", "praise", "partner_request", "other"]
        },
        "posture": { "type": "string" },
        "surfaces": { "type": "array", "items": { "$ref": "#/$defs/OutputSurface" }, "uniqueItems": true },
        "voice": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "persona": { "type": "string", "enum": ["normal", "restrained", "suspended"] },
            "formalityDelta": { "$ref": "#/$defs/ScaleDelta" },
            "warmthDelta": { "$ref": "#/$defs/ScaleDelta" },
            "instruction": { "type": "string" }
          }
        },
        "rails": { "$ref": "#/$defs/RailList" },
        "suspended_rule_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "uniqueItems": true,
          "description": "May reference only contextual rules."
        }
      }
    },

    "ParticipantRole": {
      "type": "string",
      "enum": ["brand_owner", "brand_team", "agency", "freelancer", "ramoira_facilitator"]
    },
    "ParticipantId": { "type": "string", "pattern": "^p_[A-Za-z0-9_.:-]{1,124}$" },
    "Closeness": {
      "type": ["number", "null"],
      "description": "A participant's rated closeness to an archetype, or null when the participant does not know its exemplars. A fact about a judgment, never a score of the brand. The scale and its labels are named by draft_provenance.instrument_version; Ramoira's drafting instrument maps four labels to 1, 0.67, 0.33 and 0."
    },
    "ClosenessBasis": {
      "type": "string",
      "enum": ["intended", "current"],
      "description": "intended: how close the brand should be (the standard; the default when absent). current: how close the brand's content sounds today."
    },
    "ProbeChoice": {
      "anyOf": [{ "$ref": "#/$defs/Id" }, { "type": "null" }],
      "description": "A probe_id from the contrast set, or null."
    },
    "DraftProvenance": {
      "type": "object",
      "description": "How the candidate was produced. Outside content_hash. Never a score of the brand. Never in a summary.",
      "required": ["method"],
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "enum": ["archetype_anchored", "questionnaire", "document_import", "manual"] },
        "instrument_version": { "type": ["string", "null"] },
        "intake": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "category": { "type": "string" },
            "description": { "type": "string" },
            "founded": { "type": ["string", "null"] },
            "source_documents": { "type": "array", "items": { "type": "string", "format": "uri" } }
          }
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["participant_id", "role"],
            "additionalProperties": false,
            "properties": {
              "participant_id": { "$ref": "#/$defs/ParticipantId" },
              "role": { "$ref": "#/$defs/ParticipantRole" }
            }
          }
        },
        "closeness_ratings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["archetype_id", "closeness"],
            "additionalProperties": false,
            "properties": {
              "archetype_id": { "$ref": "#/$defs/Id" },
              "closeness": { "$ref": "#/$defs/Closeness" },
              "answered_by": { "$ref": "#/$defs/ParticipantId", "description": "Who rated. Required from 3.1.0: the rater is part of what a closeness rating is." },
              "basis": { "$ref": "#/$defs/ClosenessBasis" },
              "exemplars_known": { "type": "boolean", "description": "false when the participant does not know the exemplar brands; closeness is then null." }
            }
          }
        },
        "anchors": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["archetype_id", "closeness"],
            "additionalProperties": false,
            "properties": {
              "archetype_id": { "$ref": "#/$defs/Id" },
              "closeness": { "$ref": "#/$defs/Closeness" },
              "exemplars_shown": { "$ref": "#/$defs/StringList" }
            }
          }
        },
        "delta_answers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["zone_id", "field", "question", "answer", "answered_by"],
            "additionalProperties": false,
            "properties": {
              "zone_id": { "$ref": "#/$defs/Id" },
              "field": { "$ref": "#/$defs/JsonPointer" },
              "question": { "$ref": "#/$defs/NonEmptyString" },
              "answer": { "type": "string" },
              "answered_by": { "$ref": "#/$defs/ParticipantId" }
            }
          }
        },
        "fields": {
          "type": "object",
          "description": "JSON pointer to inheritance status. unfilled fields are shown at ratification as a thinness warning.",
          "propertyNames": { "$ref": "#/$defs/JsonPointer" },
          "additionalProperties": { "type": "string", "enum": ["inherited", "adapted", "authored", "affirmed", "unfilled"] }
        },
        "reactions": {
          "type": "array",
          "description": "Owner verdicts on elicitation probes. Probe texts are evidence of a judgment, never content.",
          "items": {
            "type": "object",
            "required": ["probe_id", "surface", "text", "reaction", "reason", "answered_by", "captured_at"],
            "additionalProperties": false,
            "properties": {
              "probe_id": { "$ref": "#/$defs/Id" },
              "set_id": { "$ref": "#/$defs/Id", "description": "The contrast set this reaction came from (3.1.0): its most-like-us probe is recorded as yes, its least-like-us probe as no." },
              "surface": { "anyOf": [{ "$ref": "#/$defs/OutputSurface" }, { "$ref": "#/$defs/NonEmptyString" }] },
              "text": { "$ref": "#/$defs/NonEmptyString" },
              "reaction": { "type": "string", "enum": ["yes", "close", "no"] },
              "reason": { "type": ["string", "null"] },
              "answered_by": { "$ref": "#/$defs/ParticipantId" },
              "captured_at": { "$ref": "#/$defs/IsoDate" },
              "resulted_in": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "fields": { "type": "array", "items": { "$ref": "#/$defs/JsonPointer" } },
                  "example_ids": { "type": "array", "items": { "$ref": "#/$defs/Id" } }
                }
              }
            }
          }
        },
        "contrast_sets": {
          "type": "array",
          "description": "3.1.0. Choices among fixed probe lines for one delta zone: the probe most like the brand, the one least like it, or none of these, with the participant's reason. Probe lines are stimuli, never content.",
          "items": {
            "type": "object",
            "required": ["set_id", "zone_id", "field", "surface", "probe_ids", "best", "worst", "none_of_these", "reason", "answered_by", "captured_at"],
            "additionalProperties": false,
            "properties": {
              "set_id": { "$ref": "#/$defs/Id" },
              "zone_id": { "$ref": "#/$defs/Id" },
              "field": { "$ref": "#/$defs/JsonPointer" },
              "surface": { "anyOf": [{ "$ref": "#/$defs/OutputSurface" }, { "$ref": "#/$defs/NonEmptyString" }] },
              "probe_ids": { "type": "array", "items": { "$ref": "#/$defs/Id" }, "minItems": 2, "uniqueItems": true },
              "best": { "$ref": "#/$defs/ProbeChoice" },
              "worst": { "$ref": "#/$defs/ProbeChoice" },
              "none_of_these": { "type": "boolean" },
              "reason": { "type": ["string", "null"] },
              "answered_by": { "$ref": "#/$defs/ParticipantId" },
              "captured_at": { "$ref": "#/$defs/IsoDate" }
            }
          }
        },
        "retests": {
          "type": "array",
          "description": "3.1.0. A contrast set shown again, reshuffled, to the same participant. Agreement is computed by whoever reads the record; it is never stored here.",
          "items": {
            "type": "object",
            "required": ["set_id", "best", "worst", "none_of_these", "answered_by", "captured_at"],
            "additionalProperties": false,
            "properties": {
              "set_id": { "$ref": "#/$defs/Id" },
              "best": { "$ref": "#/$defs/ProbeChoice" },
              "worst": { "$ref": "#/$defs/ProbeChoice" },
              "none_of_these": { "type": "boolean" },
              "answered_by": { "$ref": "#/$defs/ParticipantId" },
              "captured_at": { "$ref": "#/$defs/IsoDate" }
            }
          }
        },
        "competitor_ratings": {
          "type": "array",
          "description": "3.1.0. A participant's placement of a named competitor on the archetypes. A perception recorded by the brand, never a measure of the competitor.",
          "items": {
            "type": "object",
            "required": ["competitor_name", "archetype_id", "closeness", "answered_by", "captured_at"],
            "additionalProperties": false,
            "properties": {
              "competitor_name": { "$ref": "#/$defs/NonEmptyString" },
              "archetype_id": { "$ref": "#/$defs/Id" },
              "closeness": { "$ref": "#/$defs/Closeness" },
              "exemplars_known": { "type": "boolean" },
              "answered_by": { "$ref": "#/$defs/ParticipantId" },
              "captured_at": { "$ref": "#/$defs/IsoDate" }
            }
          }
        }
      }
    },
    "DraftProvenanceAt300": {
      "description": "draft_provenance in a document that declares spec_version 3.0.0: none of the fields added in 3.1.0.",
      "properties": {
        "closeness_ratings": {
          "items": { "properties": { "answered_by": false, "basis": false, "exemplars_known": false } }
        },
        "reactions": { "items": { "properties": { "set_id": false } } },
        "contrast_sets": false,
        "retests": false,
        "competitor_ratings": false
      }
    },

    "Archetype": {
      "type": "object",
      "description": "Present only when schema_type is archetype. Describes the template and its delta zones. Outside content_hash. Exemplars are brand names only, used as reference points in closeness questions.",
      "required": ["archetype_id", "name", "exemplars", "delta_zones"],
      "additionalProperties": false,
      "properties": {
        "archetype_id": { "$ref": "#/$defs/Id" },
        "name": { "$ref": "#/$defs/NonEmptyString" },
        "tagline": { "type": "string" },
        "core_insight": { "type": "string" },
        "exemplars": { "$ref": "#/$defs/StringList" },
        "not_for": { "$ref": "#/$defs/StringList" },
        "delta_zones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["zone_id", "label", "question", "impact", "fields"],
            "additionalProperties": false,
            "properties": {
              "zone_id": { "$ref": "#/$defs/Id" },
              "label": { "$ref": "#/$defs/NonEmptyString" },
              "question": { "$ref": "#/$defs/NonEmptyString" },
              "impact": { "type": "string", "enum": ["high", "medium", "low"] },
              "fields": { "type": "array", "items": { "$ref": "#/$defs/JsonPointer" }, "minItems": 1, "uniqueItems": true },
              "surfaces": { "type": "array", "items": { "$ref": "#/$defs/OutputSurface" }, "uniqueItems": true },
              "situation_ids": { "type": "array", "items": { "$ref": "#/$defs/Id" }, "uniqueItems": true },
              "divergence_signals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["signal", "delta", "fields"],
                  "additionalProperties": false,
                  "properties": {
                    "signal": { "$ref": "#/$defs/NonEmptyString" },
                    "delta": { "$ref": "#/$defs/NonEmptyString" },
                    "fields": { "type": "array", "items": { "$ref": "#/$defs/JsonPointer" }, "minItems": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
