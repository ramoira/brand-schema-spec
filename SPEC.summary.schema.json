{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ramoira.com/schema/v3/SPEC.summary.schema.json",
  "title": "Ramoira Brand Schema 3.0.0 (public summary)",
  "description": "Normative JSON Schema for the public summary (schema_type: summary). Includes every public rule and all of identity, narrative and voice, identically at every tier. Excludes by default the commercial and governance layers, private rules and identity.prism.culture.sacredBoundary; the brand can opt any of these in. Never contains draft_provenance. content_hash and ratification identify the full schema the summary was extracted from.",
  "type": "object",
  "required": [
    "ramoira",
    "rules",
    "identity",
    "narrative",
    "voice"
  ],
  "additionalProperties": false,
  "properties": {
    "ramoira": {
      "$ref": "#/$defs/SummaryRamoira"
    },
    "rules": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "SPEC.schema.json#/$defs/Rule"
          },
          {
            "properties": {
              "visibility": {
                "const": "public"
              }
            }
          }
        ]
      }
    },
    "identity": {
      "$ref": "SPEC.schema.json#/$defs/Identity"
    },
    "narrative": {
      "$ref": "SPEC.schema.json#/$defs/Narrative"
    },
    "voice": {
      "$ref": "SPEC.schema.json#/$defs/Voice"
    },
    "commercial": {
      "$ref": "SPEC.schema.json#/$defs/Commercial"
    },
    "governance": {
      "$ref": "SPEC.schema.json#/$defs/Governance"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ramoira": {
            "properties": {
              "summary_opt_in": {
                "contains": {
                  "const": "commercial"
                }
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "commercial"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "ramoira": {
            "properties": {
              "summary_opt_in": {
                "contains": {
                  "const": "governance"
                }
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "governance"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "ramoira": {
            "properties": {
              "summary_opt_in": {
                "contains": {
                  "const": "sacred_boundary"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "identity": {
            "properties": {
              "prism": {
                "properties": {
                  "culture": {
                    "not": {
                      "required": [
                        "sacredBoundary"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "SummaryRamoira": {
      "type": "object",
      "required": [
        "spec_version",
        "schema_type",
        "brand_id",
        "schema_version",
        "content_hash",
        "workflow_state",
        "ratification",
        "account_owner_verified",
        "canonical_url",
        "summary_opt_in"
      ],
      "additionalProperties": false,
      "properties": {
        "spec_version": {
          "$ref": "SPEC.schema.json#/$defs/SpecVersion"
        },
        "schema_type": {
          "const": "summary"
        },
        "brand_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "$ref": "SPEC.schema.json#/$defs/ContentHash",
          "description": "The content_hash of the full schema this summary was extracted from. It is not recomputable from the summary."
        },
        "workflow_state": {
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "published",
            "archived"
          ]
        },
        "ratification": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "SPEC.schema.json#/$defs/Ratification"
            }
          ]
        },
        "account_owner_verified": {
          "type": "boolean"
        },
        "canonical_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "summary_opt_in": {
          "$ref": "SPEC.schema.json#/$defs/SummaryOptIn"
        }
      }
    }
  }
}
